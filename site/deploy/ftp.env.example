FTP_HOST=s-abroad.asia
FTP_USER=s-abroad
FTP_PASS=
FTP_REMOTE_DIR=/         # домашняя папка FTP-аккаунта (/s-abroad.asia в Plesk) — это и есть корень сайта
SITE_URL=https://s-abroad.asia
DIST_DIR=dist            # vite build → site/dist
ASSETS_DIR=assets        # хэшированные файлы Vite (только здесь удаляются старые)
PROTECT=                 # статический сайт — защищать на сервере нечего
CHECK_PATHS=/,/og.png,/manifest.webmanifest,/favicon.svg
